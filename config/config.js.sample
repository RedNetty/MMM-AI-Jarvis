/**
 * MMM-AI-Jarvis sample config.
 * Copy relevant section into your MagicMirror config/config.js modules array.
 */
{
  module: "MMM-AI-Jarvis",
  position: "bottom_center",  // any MagicMirror position
  config: {
    // Required
    projectId: "your-gcp-project-id",

    // Optional — defaults shown
    location: "us-central1",
    model: "gemini-1.5-pro-001",
    activationKeyword: "jarvis",
    speechLanguage: "en-US",
    ttsVoice: {
      languageCode: "en-US",
      name: "en-US-Neural2-D",
      ssmlGender: "MALE",
    },
    serviceAccountFile: "credentials.json",  // relative to module dir
    maxTokens: 1024,
    showTranscription: true,
    showResponse: true,
    responseTimeout: 5000,
  }
}
