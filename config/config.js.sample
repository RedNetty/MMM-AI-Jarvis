/**
 * MMM-AI-Jarvis (IRIS: Image Recognition & Intelligent Speech) — sample configuration
 *
 * Copy the object below into the `modules: [ … ]` array of
 * ~/MagicMirror/config/config.js. Every option is optional; the values shown
 * are the defaults. Only include what you want to change – nested sections
 * are merged with the defaults, so `llm: { model: "qwen3.5:2b" }` keeps every
 * other llm option.
 *
 * Everything runs locally: whisper.cpp (speech-to-text), Ollama (language +
 * vision model) and Kokoro or Piper (voice). See README.md for setup.
 */
{
  module: "MMM-AI-Jarvis",
  position: "lower_third",                       // middle_center and bottom_center also work well
  config: {
    // ── Identity ───────────────────────────────────────────────────────────
    assistantName: "Iris",
    wakeWord: "iris",                            // say this first, e.g. "Iris, what should I wear?"
    wakeWordAliases: ["aris", "irus", "iras", "eyeris"], // mis-hearings that also count
    userName: "",                                // personalises replies, e.g. "Alex"
    language: "en",                              // Whisper language code ("en", "de", "fr", "es", …)
    locale: null,                                // date/time format; null = MagicMirror's `locale`
    units: null,                                 // "metric" | "imperial"; null = MagicMirror's `units`
    dataDir: "data",                             // wardrobe, memory and photos (inside the module folder)
    debug: false,                                // verbose logs (transcripts, timings)

    // ── Speech-to-text (whisper.cpp server) ──────────────────────────────
    stt: {
      whisperUrl: "http://127.0.0.1:8178",       // or a list: a Mac first, the Pi as fallback, e.g.
                                                 // ["http://macbook.local:8178", "http://127.0.0.1:8178"]
    },

    // ── Text-to-speech ─────────────────────────────────────────────────────
    tts: {
      provider: "auto",                          // the most natural voice running: Kokoro, then Piper, then espeak-ng.
                                                 // Or force one: "kokoro" | "piper" | "espeak" (robotic)
      kokoroUrl: "",                             // Kokoro voice server, e.g. "http://macbook.local:5006"; "" = this machine
      kokoroVoice: "af_heart",                   // af_heart, af_bella, am_michael, am_adam, bf_emma, bm_george, …
      kokoroSpeed: null,                         // 1.1 = a little faster
      piperUrl: "http://127.0.0.1:5005",         // persistent Piper server (fast); a list for failover; "" = CLI only
      piperCommand: "~/.local/share/iris/piper-venv/bin/piper",          // CLI fallback
      piperModel: "~/.local/share/iris/voices/en_US-lessac-medium.onnx", // CLI fallback voice
      piperSpeaker: null,                        // speaker id for multi-speaker voices
      piperLengthScale: null,                    // speaking speed: 0.9 = faster, 1.1 = slower
      piperArgs: [],                             // extra CLI args passed to piper
      espeakVoice: "en-us",
      espeakSpeed: 165,
      mergeChars: 260,                           // speak sentences after the first together, for natural flow (0 = one at a time)
    },

    // ── Language & vision model (Ollama) ───────────────────────────────────
    llm: {
      // Run the model on a faster computer (e.g. an Apple Silicon Mac set up with setup-mac.sh --share),
      // falling back to the Pi when it's off. Each server has its own model:
      // servers: [
      //   { url: "http://macbook.local:11434", model: "qwen3.5:4b" },
      //   { url: "http://127.0.0.1:11434", model: "qwen3.5:2b" },
      // ],
      servers: [],                               // empty = use ollamaUrl + model below
      ollamaUrl: "http://127.0.0.1:11434",
      model: "qwen3.5:2b",                       // fastest on a Pi · qwen3.5:4b smarter but ~35% slower · LAN PC: qwen3.5:9b
      visionModel: "",                           // "" = use `model` (qwen3.5 can see)
      keepAlive: -1,                             // keep the model in RAM (-1 = forever); reloading from SD card is slow
      temperature: 0.4,
      maxTokens: 160,                            // spoken replies are short; fewer tokens = faster on a Pi
      contextSize: 4096,                         // larger contexts use more RAM and are slower
      think: false,                              // slower but more careful reasoning on thinking models
      fastIntents: true,                         // handle common requests without the LLM (faster, reliable on small models)
      router: "auto",                            // let the model route free-form requests: "auto" (only on a fast server, e.g. a Mac) | true | false
      outfitPlanner: "fast",                     // "fast" = instant rule-based picks; "ai" = the language model chooses (slower on a Pi)
    },

    // ── Microphone, speaker & voice detection ─────────────────────────────
    audio: {
      micDevice: "default",                      // ALSA device, e.g. "plughw:1,0" (list with: arecord -L)
      speakerDevice: "default",                  // ALSA device (list with: aplay -L)
      vadThreshold: 500,                         // minimum loudness counted as speech (raise if noise triggers it)
      noiseMultiplier: 3,                        // speech must be this many × louder than room noise
      silenceMs: 750,                            // pause that ends a sentence (lower = snappier, may cut slow talkers off)
      pauseMs: 300,                              // transcribe at the first short pause; "Iris." alone or a finished
                                                 // question is answered without waiting out silenceMs (0 = off)
      preRollMs: 400,                            // audio kept from just before speech started
      minUtteranceMs: 350,
      maxUtteranceMs: 15000,
      allowBargeIn: true,                        // "Iris, stop" while speaking (its own voice is filtered out)
      chime: true,                               // soft tone when the wake word is heard on its own
      chimeVolume: 0.25,
    },

    // ── Camera (vision & wardrobe) ─────────────────────────────────────────
    camera: {
      enabled: true,
      tool: "auto",                              // auto | rpicam-still | libcamera-still | fswebcam | ffmpeg | custom
      device: "/dev/video0",                     // USB webcam device
      width: 960,                                // larger photos make the vision model much slower
      height: 720,
      rotation: 0,                               // 0 or 180
      flip: false,                               // horizontal mirror
      warmupMs: 1200,                            // let auto-exposure settle
      customCommand: [],                         // for tool "custom": argv that writes a JPEG to stdout ({width} {height} {device})
    },

    // ── Weather for outfit planning ────────────────────────────────────────
    // Leave null to reuse MagicMirror's built-in weather module (no extra calls).
    // Set coordinates to fetch from Open-Meteo instead (free, no API key, and adds the hourly
    // detail behind answers about "tonight" or "tomorrow morning").
    weather: {
      latitude: null,
      longitude: null,
      locationName: "",
    },

    // ── Live sports scores (ESPN public feed, no API key) ──────────────────
    sports: {
      enabled: true,
      // Leagues searched when you don't name one. Available: nfl, ncaaf, nba, wnba, ncaab, mlb, nhl,
      // epl, championship, laliga, bundesliga, seriea, ligue1, mls, ucl, uel
      leagues: ["nfl", "nba", "mlb", "nhl", "epl", "mls", "ucl", "laliga", "bundesliga", "seriea"],
      favorites: [],                             // your teams, e.g. ["Lakers", "Arsenal"]: in the briefing, plus live alerts
    },

    // ── Knowledge & data (free public sources, no keys) ─────────────────────
    // Wikipedia facts, Google News, Yahoo Finance, ECB exchange rates, dictionary.
    info: {
      enabled: true,                             // false = no lookups (weather and scores still work)
      newsFeeds: [],                             // RSS URLs for "the news" instead of Google News top stories
      currency: null,                            // home currency, e.g. "GBP"; null = from your locale
    },

    // ── Things IRIS does on its own ──────────────────────────────────────────
    proactive: {
      enabled: true,
      briefing: true,                            // morning briefing the first time someone is around
      briefingHours: [5, 11],                    // …between these hours
      rainAlerts: true,                          // "Heads up: rain is likely in about 40 minutes"
      teamAlerts: true,                          // kick-off and final score for sports.favorites
      quietHours: [22, 7],                       // alerts are shown, not spoken
      awayAfterMinutes: 15,                      // nobody heard or seen for this long → shown, not spoken
    },

    // ── Web search (optional, self-hosted) ─────────────────────────────────
    search: {
      searxngUrl: "",                            // e.g. "http://127.0.0.1:8888" – leave empty to disable
    },

    // ── Your own voice commands → MagicMirror notifications ────────────────
    // Drive any other module by voice. Examples:
    customCommands: [
      // { phrases: ["next page", "page forward"], notification: "PAGE_INCREMENT", reply: "Next page." },        // MMM-pages
      // { phrases: ["previous page"], notification: "PAGE_DECREMENT", reply: "Going back." },
      // { phrases: ["show my alerts"], notification: "SHOW_ALERT", payload: { title: "Hi", message: "Hello!" } },
    ],

    // ── Conversation ───────────────────────────────────────────────────────
    conversation: {
      listenTimeout: 8000,                       // after "Iris" alone, how long to wait for the question
      followUpWindow: 8000,                      // reply without the wake word for this long after an answer (0 = off)
      historyTurns: 6,                           // remembered exchanges within a conversation
      resetAfter: 300000,                        // start a fresh conversation after 5 idle minutes
    },

    // ── Display ────────────────────────────────────────────────────────────
    display: {
      showTranscription: true,
      showResponse: true,
      clearAfter: 30000,                         // hide the conversation after this long idle (0 = never)
      maxWidgets: 4,                             // cards on screen at once (running timers are never dropped)
      cardTimeout: 90000,                        // outfit / wardrobe cards
      infoTimeout: 180000,                       // info panels Iris puts on screen
      snapshotTimeout: 8000,                     // camera preview
      errorTimeout: 6000,
      showProblems: true,                        // show setup problems (e.g. Ollama not running) on the mirror
      autoHide: ["compliments"],                 // modules faded out while Iris is showing something
    },
  },
}
